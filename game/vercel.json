{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ':(top)' ':(top,exclude)game/docs' ':(top,exclude)game/server' ':(top,exclude)game/tests' ':(top,exclude)game/tools' ':(top,exclude).github' ':(top,exclude,glob)**/.gitignore' ':(top,exclude,glob)**/*.md'",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/wiki", "destination": "/index.html" },
    { "source": "/wiki/", "destination": "/index.html" },
    { "source": "/wiki/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "orbita-zero.vercel.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/versao.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
