{
  "name": "orbita-zero-api",
  "private": true,
  "type": "module",
  "scripts": {
    "chat:dev": "wrangler dev --config wrangler.chat.toml --env local --port 8788",
    "chat:db:local": "wrangler d1 execute orbita-zero-chat --config wrangler.chat.toml --local --file=chat-schema.sql",
    "chat:check": "wrangler deploy --config wrangler.chat.toml --dry-run --outdir .wrangler/chat-build",
    "chat:test": "npm run chat:check && node ../tools/test-chat-integration.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute orbita-zero --local --file=schema.sql",
    "db:remoto": "wrangler d1 execute orbita-zero --remote --file=schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260827.1",
    "wrangler": "^4.127.0"
  }
}
