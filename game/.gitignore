node_modules/
dist/
.snapshots/

# Registro de proveniência gravado pelo pipeline (entrada da auditoria)
.assets/

# Pacote processado de artes usado pelo deploy. Os packs crus continuam fora
# do repositório; quando forem atualizados, gere novamente com `npm run assets`
# e versione o resultado daqui.

# Servidor (Cloudflare Worker)
server/node_modules/
server/.wrangler/
server/.dev.vars

# Mockups de landing em avaliacao. Ficam em public/ para o servidor de dev
# servi-los e o Rafael clicar — e FORA do git para nao subirem num deploy
# antes de ele escolher um modelo.
public/mockups/

# A escolha de ambiente é de cada máquina: `.env.example` mostra o formato e
# `.env.local` guarda o destino real. Versionar o segundo faria o destino de
# um virar o destino de todos — e um `.env.local` apontando para produção
# transformaria qualquer teste local em escrita no banco dos jogadores.
.env.local
.env.*.local
