{
  "name": "orbita-zero",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "description": "Órbita Zero — idle de naves espaciais com camada horizontal (farm fino) e camada vertical (combate pilotado por IA).",
  "scripts": {
    "assets": "npm run assets:mapa && node tools/build-assets.mjs",
    "assets:loja": "node tools/optimize-shop-service-icons.mjs",
    "assets:afixos": "node tools/optimize-affix-craft-icon.mjs",
    "assets:organizar": "node tools/build-assets.mjs && node tools/organize-assets.mjs",
    "assets:folha": "node tools/contact-sheet.mjs",
    "assets:recursos:audit": "node tools/auditar-artes-recursos.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "simular": "node tools/run-ts.mjs tools/simular.ts",
    "simular:descarte": "node tools/run-ts.mjs tools/auditar-descarte.ts",
    "cascos:listar": "node tools/run-ts.mjs tools/listar-cascos.ts",
    "assets:mapa": "node tools/run-ts.mjs tools/gerar-mapa-de-sprites.ts"
  },
  "devDependencies": {
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
